# ==============================================================================
# TeslaCost Environment Configuration
# ==============================================================================

# Server configuration
PORT=8080
APP_BASE_URL=http://localhost:8080
# ENVIRONMENT=production switches logs to JSON and defaults the log level to INFO
# (never DEBUG), enables Secure cookies, and activates the insecure-defaults warning.
# Set to "development" only for local work outside docker-compose.dev.yml.
ENVIRONMENT=production
# LOG_LEVEL overrides the default for either mode: DEBUG, INFO, WARN or ERROR.
# LOG_LEVEL=INFO

# TESLACOST_VERSION: pin a specific release tag (e.g. v1.17.0) for reproducible deployments.
# Leave as "latest" only for quick testing; pin it before running this in production.
TESLACOST_VERSION=latest

# Database configuration (PostgreSQL)
# Recommended: Use granular DB_* variables (handles special characters in password automatically):
DB_HOST=postgres
DB_PORT=5432
DB_USER=teslacost
DB_PASSWORD=teslacost_dev_secret
DB_NAME=teslacost
DB_SSLMODE=disable
# DB_PORT_BIND: host bind address:port for the postgres container (127.0.0.1 only by default).
# Set to 0.0.0.0:5432 (or similar) only if you need to reach Postgres from outside this host.
DB_PORT_BIND=127.0.0.1:5432

# Alternative: Full connection string (note: special characters in password must be percent-encoded if used)
# DATABASE_URL=postgres://teslacost:teslacost_dev_secret@localhost:5432/teslacost?sslmode=disable

# Security & Secrets
# APP_ENCRYPTION_KEY: Secret key used to encrypt/decrypt TeslaMate API credentials in DB (AES-256-GCM)
APP_ENCRYPTION_KEY=generate_a_random_32_characters_key_here!
# JWT_SECRET: Secret key for signing user authentication tokens
JWT_SECRET=super_secret_jwt_signing_key_for_teslacost_app
JWT_EXPIRATION_HOURS=72

# User Registration & Initial Admin Setup
# DISABLE_REGISTRATION: set to true to prevent any new user registration
DISABLE_REGISTRATION=false

# Optional: Auto-create initial admin account on first startup (especially useful if DISABLE_REGISTRATION=true)
# INITIAL_ADMIN_EMAIL=admin@your-domain.com
# INITIAL_ADMIN_PASSWORD=YourSecurePassword123!

# Reporting timezone (IANA name) used to group costs by month
APP_TIMEZONE=Europe/Paris

# CORS: leave unset. The embedded frontend is same-origin as the API, so the origin of
# APP_BASE_URL is allowed automatically (plus the local dev servers outside production).
# Only set this (comma-separated) to allow a frontend served from another origin.
# CORS_ALLOWED_ORIGINS=https://other-frontend.example.com

# Document File Storage Directory (mounted volume)
STORAGE_DIR=/data/documents

# Automated backups (postgres dump + documents archive), stored in the
# teslacost_backups volume. Copy them off-host regularly (Proxmox backup job,
# rsync, ...): a named volume alone does not protect against disk/host loss.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# --- OIDC / SSO (Optional) ---
# Leave OIDC_ISSUER_URL empty to use local email/password authentication only.
# OIDC_ISSUER_URL=https://auth.homelab.local/application/o/teslacost/
# OIDC_CLIENT_ID=teslacost
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://teslacost.homelab.local/api/auth/oidc/callback
# OIDC_PROVIDER_NAME=Authentik
# OIDC_SCOPES=openid email profile
# OIDC_ALLOWED_EMAILS=
# OIDC_DISABLE_LOCAL_AUTH=false
